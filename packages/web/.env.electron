# This file configures which backend the PACKAGED desktop app talks to.
# Vite automatically loads .env.production during `vite build`.
#
# For local development/testing of the desktop shell against a locally
# running backend, the default below (localhost:4000) is correct.
#
# For a real release build, change this to your deployed API's origin,
# e.g.:
#   VITE_API_BASE_URL=https://api.axisvault.example.com/api

VITE_API_BASE_URL=http://localhost:4000/api
VITE_ROUTER_MODE=hash
