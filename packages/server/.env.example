# Copy this file to .env and fill in real values before running the server.
# NEVER commit a real .env file — secrets belong in your deployment
# platform's secret manager (e.g. AWS Secrets Manager, Doppler, Vault).

NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://axisvault:axisvault_dev_password@localhost:5432/axisvault
DB_SSL=false
DB_POOL_MAX=10

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

CORS_ORIGIN=http://localhost:5173
# Enable ONLY if you ship the Electron desktop build and it talks to this
# server directly (file:// pages send Origin: null, which has no domain to
# allowlist via CORS_ORIGIN above). Leave false for web-only deployments.
ALLOW_NULL_ORIGIN=false

SERVER_ARGON2_MEMORY_KIB=19456
SERVER_ARGON2_TIME_COST=2
SERVER_ARGON2_PARALLELISM=1

RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
